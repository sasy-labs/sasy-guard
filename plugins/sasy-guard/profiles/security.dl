/*
    Security profile — the unified "turn it all on" default.

    One policy, fourteen independently-toggleable rule groups (the old separate
    rm-rf-block / taint-untrusted-fetch / supply-chain profiles are now groups
    here). Every group is ON by default; a deployment dials coverage via
    PolicyMetadata flags WITHOUT recompiling (the same baked evaluator serves
    every configuration — config varies, logic is fixed):
      - PolicyMetadata("rule_off", "<group>", "")  — drop a group (subtractive).
      - PolicyMetadata("rule_on",  "<group>", "")  — opt-in mode: ONLY the
        on-listed groups (e.g. rule_on data_loss == the old rm-rf-block).

    Groups: data_loss, secret_scan, exfil, toxic_flow, reverse_shell,
            config_persistence, guard_config, agent_redirect, curl_sh,
            hidden_unicode, public_push, review_gate, supply_chain, dep_scan.

    All gates are substring/graph heuristics: an agent running arbitrary code
    can obfuscate around them. The goal is to patch common failure modes, not
    to stop a determined adversary.
*/

#include "common_policy.dl"

// Default: authorize everything not explicitly denied below.
IsAuthorized(idx) :- Actions(idx, _).

/* ── Rule-group enable flags (default: ALL on) ──────────────────────────
   Every numbered block below is gated on RuleEnabled("<group>"). With NO
   metadata pinned, all groups are on — this profile is the "turn it all on"
   default. Two override modes via PolicyMetadata (no recompile — the same
   baked evaluator serves every configuration):
     - subtractive:  PolicyMetadata("rule_off", "<group>", "")  removes a group
                     from the default-all set.
     - explicit:     PolicyMetadata("rule_on",  "<group>", "")  switches to
                     opt-in — ONLY the on-listed groups run (minimal/demo
                     configs, e.g. the old rm-rf-block = rule_on data_loss).
   Groups: data_loss secret_scan exfil toxic_flow reverse_shell
           config_persistence guard_config agent_redirect curl_sh
           hidden_unicode public_push review_gate supply_chain dep_scan. */
.decl KnownRule(group: symbol)
KnownRule("data_loss").     KnownRule("secret_scan").        KnownRule("exfil").
KnownRule("toxic_flow").    KnownRule("reverse_shell").      KnownRule("config_persistence").
KnownRule("guard_config").  KnownRule("agent_redirect").     KnownRule("curl_sh").
KnownRule("hidden_unicode").KnownRule("public_push").        KnownRule("review_gate").
KnownRule("supply_chain").  KnownRule("dep_scan").  KnownRule("sast").

.decl RuleOff(group: symbol)
RuleOff(g) :- PolicyMetadata("rule_off", g, _).
.decl RuleOn(group: symbol)
RuleOn(g) :- PolicyMetadata("rule_on", g, _).
.decl ExplicitMode()
ExplicitMode() :- RuleOn(_).

.decl RuleEnabled(group: symbol)
RuleEnabled(g) :- KnownRule(g), !ExplicitMode(), !RuleOff(g).  // default-all minus rule_off
RuleEnabled(g) :- RuleOn(g).                                   // explicit opt-in

// Transitive reachability over the dependency graph (scan-after-edit). Consumed ONLY
// as Reaches(<edit|scan>, <scan|review-SINK>), so it is ROOTED at the sink set — see
// the definition at the end of the file (ReachSink). The old all-pairs closure from
// every node materialized O(n²) ancestor-descendant pairs and made policy eval grow
// quadratically with session length (≈6 s at ~5k nodes); sink-rooting makes it O(n).
.decl Reaches(src: symbol, dst: symbol)

.decl InContext(id: symbol)
InContext(id) :- Current(id).
InContext(id) :- CurrentDepends(id).

/* ── 1. Data loss ──────────────────────────────────────────────────── */

.decl ShellCommand(idx: unsigned, cmd: symbol)
ShellCommand(idx, cmd) :-
    Actions(idx, a),
    a = $CallTool("Bash", args),
    cmd = @json_get_str(args, "command").

// Normalized command (lowercased, whitespace-collapsed) — the Tier-0 hard-deny
// gates below match against THIS so `rm  -RF`, `NC -E`, a `\`-wrapped payload,
// and HTTP_PROXY/http_proxy all hit one lowercased needle. (Host extraction and
// case-sensitive path checks still use the raw `cmd`.)
.decl ShellNorm(idx: unsigned, ncmd: symbol)
ShellNorm(idx, ncmd) :- ShellCommand(idx, cmd), ncmd = @normalize_cmd(cmd).

.decl RecursiveDelete(idx: unsigned)
// `rm` with recursive AND force in ANY flag ordering — the functor tokenizes
// the command and reads rm's flags (-rf / -fr / -vrf / -r --force / --recursive
// --force / mixes), ignoring positional paths. Substring needles missed natural
// orderings like `rm -r --force` and `rm -vrf`; this subsumes them.
RecursiveDelete(idx) :- ShellCommand(idx, cmd), @dangerous_rm(cmd) = 1.
// Equivalent recursive deletes that aren't `rm` at all.
RecursiveDelete(idx) :- ShellNorm(idx, n), @str_contains(n, "find ") = 1, @str_contains(n, "-delete") = 1.
RecursiveDelete(idx) :- ShellNorm(idx, n), @str_contains(n, "find ") = 1, @str_contains(n, "-exec rm") = 1.

.decl ForcePush(idx: unsigned)
ForcePush(idx) :-
    ShellCommand(idx, cmd),
    @str_contains(cmd, "push") = 1,
    @str_contains(cmd, "--force") = 1,
    @str_contains(cmd, "--force-with-lease") = 0.
ForcePush(idx) :- ShellCommand(idx, cmd), @str_contains(cmd, "push -f") = 1.

// @deny_message: Destructive recursive delete (rm -rf) is blocked by policy
// @suggestion: Delete specific files instead of rm -rf; if the recursive delete is genuinely needed, run it outside the agent
Unauthorized(idx) :- RuleEnabled("data_loss"), RecursiveDelete(idx).
// @deny_message: Force push rewrites remote history and is blocked by policy
// @suggestion: Push without --force (or use --force-with-lease); a genuine history rewrite has to be run outside the agent
Unauthorized(idx) :- RuleEnabled("data_loss"), ForcePush(idx).

/* ── 2. Secret-scan gate on push ───────────────────────────────────── */

// Repo root the current push targets (git toplevel), supplied per-check by the
// daemon as ActionMetadata. One action per check, so match any index.
.decl RepoRoot(root: symbol)
RepoRoot(root) :- ActionMetadata(_, "repo_root", root, _).
.decl HaveRepoRoot()
HaveRepoRoot() :- RepoRoot(_).

// Args of every edit-family tool result — grounds `args` for the path check below.
// Gated on IsPush (the only consumer, RecentEdit, feeds only push rules), matching
// the relevance-gate pattern of Reaches / CurrentDepends so a benign non-push
// check doesn't materialize one tuple per session edit.
.decl EditArgs(args: symbol)
EditArgs(args) :- IsPush(_), ToolResult(_, "Edit", args).
EditArgs(args) :- IsPush(_), ToolResult(_, "Write", args).
EditArgs(args) :- IsPush(_), ToolResult(_, "MultiEdit", args).

// An edit gates a push only if its target file is INSIDE the repo being pushed:
// a push can't ship an out-of-tree file (a /tmp scratchpad script, a file under
// another repo), so those must not trip the secret-scan / review gates. `repo_root`
// carries a trailing slash (path boundary, set daemon-side) and is emitted ONLY
// for a push that targets THIS cwd's repo. file_path is absolute for the CC edit
// tools, so a prefix match suffices.
//
// FAIL-SAFE on every ambiguity — never silently drop a push-gating edit:
//   · no repo_root at all (non-git cwd, withheld/cross-repo push) → count.
//   · repo_root present but file_path missing/empty (malformed args) → count.
// The mapper's canonical path scopes modern recordings. For older recordings,
// keep the raw path as a fallback; an unresolved relative path counts rather
// than silently dropping the edit. Absolute raw paths remain a text match.
.decl EditScopePath(args: symbol, path: symbol)
EditScopePath(args, p) :- EditArgs(args),
    p = @json_get_str(args, "__sasy_edit_path"), p != "".
EditScopePath(args, p) :- EditArgs(args),
    @json_get_str(args, "__sasy_edit_path") = "",
    p = @json_get_str(args, "file_path").
// Production repo_root metadata already ends in '/'. Accept unsuffixed roots
// in older recordings too, without broadening '/repo' to '/repo-neighbor'.
.decl EditRootPrefix(prefix: symbol)
EditRootPrefix(root) :- RepoRoot(root), strlen(root) > 0,
    substr(root, strlen(root) - 1, 1) = "/".
EditRootPrefix(cat(root, "/")) :- RepoRoot(root), strlen(root) > 0,
    substr(root, strlen(root) - 1, 1) != "/".
.decl EditPathRelevant(args: symbol)
EditPathRelevant(args) :- EditScopePath(args, p), EditRootPrefix(prefix),
    @str_starts_with(p, prefix) = 1.
EditPathRelevant(args) :- EditScopePath(args, p), RepoRoot(root), p = root.
EditPathRelevant(args) :- EditScopePath(args, p), RepoRoot(root), cat(p, "/") = root.
EditPathRelevant(args) :- EditArgs(args), !HaveRepoRoot().
EditPathRelevant(args) :- EditScopePath(args, p), HaveRepoRoot(),
    @str_starts_with(p, "/") = 0.

// Edits in the current slice (Claude Code edit tools), scoped to repo files.
.decl RecentEdit(id: symbol)
RecentEdit(id) :- CurrentDepends(id), ToolResult(id, "Edit", args), EditPathRelevant(args).
RecentEdit(id) :- CurrentDepends(id), ToolResult(id, "Write", args), EditPathRelevant(args).
RecentEdit(id) :- CurrentDepends(id), ToolResult(id, "MultiEdit", args), EditPathRelevant(args).

// A gitleaks SCAN run = a Bash tool result that runs gitleaks with a scanning
// subcommand (git / dir / protect / detect), via @cmd_runs_sub — which tokenizes
// the command QUOTE-AWARELY, so flags before the subcommand
// (`gitleaks --flags git`) and wrapped forms (`sh -c 'gitleaks git'`) match,
// while a `gitleaks` name inside a quoted ARGUMENT does not: an agent cannot
// forge a scan with `echo 'x; gitleaks git; no leaks found'` (which would
// otherwise mint GitleaksRun AND GitleaksClean in one call and clear every rule
// below). Requiring a scanning subcommand also excludes `gitleaks version` /
// `command -v gitleaks` install-checks: they invoke gitleaks but never print
// "no leaks found", so they counted as run-but-never-clean and flipped an
// uncovered edit's symptom into a FALSE FlaggedEdit ("potential secret").
// `protect` is included because it is a legitimate pre-push scan — omitting it
// dead-ends the user, who runs a real clean scan and is still told to scan.
//
// A GitleaksRun also requires EVIDENCE the scan actually COMPLETED — its output
// carries gitleaks' verdict/summary line ("... leaks found" or "N commits
// scanned"). Command shape alone is not enough: a scan that fails to execute
// (`gitleaks git --badflag` usage error, a missing binary) matches the shape and
// prints no "no leaks found", so it would satisfy ScannedSinceEdit but not
// GitleaksClean → a FlaggedEdit the user could APPROVE as a false positive even
// though nothing was scanned. Requiring the summary line makes a failed scan
// count as NO scan (→ UnscannedEdit, a hard "run the scan"), not an approvable
// finding. A real dirty scan still prints "leaks found:" → GitleaksRun ∧ !Clean.
.decl GitleaksRun(id: symbol)
GitleaksRun(id) :-
    InContext(id),
    ToolResult(id, "Bash", args),
    cmd = @json_get_str(args, "command"),
    ( @cmd_runs_sub(cmd, "gitleaks", "git") = 1
    ; @cmd_runs_sub(cmd, "gitleaks", "dir") = 1
    ; @cmd_runs_sub(cmd, "gitleaks", "protect") = 1
    ; @cmd_runs_sub(cmd, "gitleaks", "detect") = 1 ),
    SentMessage(id, msg),
    ( @str_contains(msg.contents, "leaks found") = 1
    ; @str_contains(msg.contents, "Leaks found") = 1
    ; @str_contains(msg.contents, "commits scanned") = 1
    ; @str_contains(msg.contents, "scanned ~") = 1 ).

// Clean = gitleaks reported no leaks (success output).
.decl GitleaksClean(id: symbol)
GitleaksClean(id) :- GitleaksRun(id), SentMessage(id, msg), @str_contains(msg.contents, "no leaks found") = 1.
GitleaksClean(id) :- GitleaksRun(id), SentMessage(id, msg), @str_contains(msg.contents, "No leaks found") = 1.

.decl IsPush(idx: unsigned)
// A `git push` INVOCATION, via @cmd_runs_sub (tokenizes the command + reads git's
// subcommand). Matches `git push`, `git push --force`, `git -C x push`,
// `git commit && git push`, and — critically — forms that hide git behind a
// WRAPPER: `sh -c 'git push'`, `eval "git push"`, `timeout 60 git push`,
// `env`/`xargs`/`sudo`/`nohup` git push, `"git" push`, and `\`+newline splits.
// A first-word-only scan misses all of those, which would leave a prompt-injected
// agent free to push unscanned, tainted content with NO gate (IsRepoSink is
// defined from IsPush below, so a miss here disables the taint gate too).
// A `git commit` whose MESSAGE merely mentions push (even "; git push") is NOT a
// push: the tokenizer is quote-aware, so quoted text is data. This replaces both
// the "git"+"push" substring (false-positive on commit messages) and the
// contiguous "git push" stopgap (false-negative on `git -C x push`).
IsPush(idx) :- ShellCommand(idx, cmd), @cmd_runs_sub(cmd, "git", "push") = 1.

// An edit is covered iff a CLEAN scan ran after it (scan reachable from edit).
.decl CoveredByGitleaks(edit_id: symbol)
CoveredByGitleaks(e) :- RecentEdit(e), GitleaksClean(s), Reaches(e, s).

// SOME gitleaks scan (clean or not) ran after this edit.
.decl ScannedSinceEdit(edit_id: symbol)
ScannedSinceEdit(e) :- RecentEdit(e), GitleaksRun(s), Reaches(e, s).

// A clean scan that ran AFTER `s` (reachable from it), i.e. `s`'s finding has
// since been re-scanned clean.
.decl CleanScanAfter(scan: symbol)
CleanScanAfter(s) :- GitleaksRun(s), GitleaksClean(c), Reaches(s, c).

// A flagged scan is still outstanding unless a CLEAN scan ran AFTER it. ORDER
// matters in BOTH directions, so this cannot be `!GitleaksClean(_)`:
//   · dirty → clean: the later clean re-scan (leak fixed / allowlisted) clears it.
//   · clean → dirty: an EARLIER clean scan must NOT mask a newer finding. This is
//     the dangerous direction and the unordered form got it wrong — with no
//     tracked edits, `scan clean` → `git pull` brings in a secret → `re-scan
//     dirty` left this false, so C' never fired and the push shipped the secret.
// Especially load-bearing here because C' is the no-tracked-edit branch: the leak
// arrived by pull/checkout/external means, exactly when an earlier clean scan is
// stale evidence about DIFFERENT content. Mirrors CoveredByGitleaks/FlaggedEdit,
// which are per-edit ordered for the same reason ("an earlier spurious pass never
// masks a real hit"). Scans that are siblings (neither reaches the other) leave
// this true — fail-closed.
.decl GitleaksDirty()
GitleaksDirty() :- GitleaksRun(s), !GitleaksClean(s), !CleanScanAfter(s).

.decl HasRecentEdit()
HasRecentEdit() :- RecentEdit(_).

// Edit never scanned since it was made → a clear mechanical action (run the
// scan), so it stays a hard deny that NAMES the tool call to make.
.decl UnscannedEdit(edit_id: symbol)
UnscannedEdit(e) :- RecentEdit(e), !ScannedSinceEdit(e).

// Edit scanned after editing, but the covering scan FLAGGED a leak (no clean
// scan reaches it). A gitleaks hit can be a false positive, and only the user
// can tell a real secret from a spurious match — so this @asks rather than
// hard-blocks. Per-edit via `Reaches`: a later scan that finds a REAL leak on a
// NEW edit re-flags it, so an earlier spurious pass never masks a real hit.
.decl FlaggedEdit(edit_id: symbol)
FlaggedEdit(e) :- RecentEdit(e), ScannedSinceEdit(e), !CoveredByGitleaks(e).

// A) A push with no tracked edits and no scan at all → run one first. Keeps
//    "every push is scanned" even when this session made no tracked edits.
// @deny_message: Push blocked — no gitleaks secret scan has run in this session
// @suggestion: The agent must run `gitleaks git --log-opts=origin/main..HEAD` itself (a scan run elsewhere is not credited) and confirm "no leaks found" before pushing
Unauthorized(idx) :- RuleEnabled("secret_scan"), IsPush(idx), !GitleaksRun(_), !HasRecentEdit(), !SecretScanAvailable(idx).

// B) Files edited without a fresh scan covering them → (re-)scan. Clear action.
// @deny_message: Push blocked — files edited this session without a fresh gitleaks scan
// @suggestion: The agent must re-run `gitleaks git --log-opts=origin/main..HEAD` itself AFTER the latest edits (a scan run elsewhere is not credited) and confirm "no leaks found", then push
Unauthorized(idx) :- RuleEnabled("secret_scan"), IsPush(idx), UnscannedEdit(_), !SecretScanAvailable(idx).

// C) A scan flagged a potential secret in edited files → @ask (may be a false
//    positive; only the user can adjudicate). NOT a hard block.
// @ask
// @deny_message: gitleaks flagged a potential secret in files edited this session
// @suggestion: If it's a real secret, remove it and re-scan; if it's a false positive, allowlist it (.gitleaksignore) and re-scan clean, or approve the push when prompted
Unauthorized(idx) :- RuleEnabled("secret_scan"), IsPush(idx), FlaggedEdit(_), !SecretScanAvailable(idx).

// C') A scan flagged something but this session made no tracked edits to tie it
//     to → still @ask (a leak in un-edited content would ship on push).
// @ask
// @deny_message: gitleaks flagged a potential secret (not tied to a tracked edit this session)
// @suggestion: If it's a real secret, remove it and re-scan; if it's a false positive, allowlist it (.gitleaksignore) and re-scan clean, or approve the push when prompted
Unauthorized(idx) :- RuleEnabled("secret_scan"), IsPush(idx), GitleaksDirty(), !HasRecentEdit(), !SecretScanAvailable(idx).

// ── Daemon-scanned path (preferred) ──────────────────────────────────
// The daemon scans the commits a push would publish, incrementally: a
// background pass advances an anchor commit-by-commit, so the push itself only
// scans what is new since that anchor. It reports one verdict, which is all the
// policy needs.
//
// Everything above this line exists to reconstruct the same answer from the
// message graph -- whether a scan ran, whether it was clean, and whether it
// covered each edit -- because there was nowhere else to get it. Those rules are
// the OPT-OUT path (`secretScanIncremental: false`): they apply only when the
// daemon produced no verdict at all. SecretScanAvailable holds for each supported
// verdict -- `unavailable` (no scanner, or the scan budget spent) and
// `unscannable` (a range the scan could not cover) included -- so a verdict
// silences them and the two paths cannot double-gate. An unknown status keeps
// the transcript rules active. While it held for `clean`
// and `leaks` only, a missing scanner fired a hard deny from above beside the
// @ask below, and the deny won.
.decl SecretScanVerdict(idx: unsigned, v: symbol)
SecretScanVerdict(idx, v) :- ActionMetadata(idx, "secret_scan", v, _).

.decl SecretScanAvailable(idx: unsigned)
SecretScanAvailable(idx) :- SecretScanVerdict(idx, "clean").
SecretScanAvailable(idx) :- SecretScanVerdict(idx, "leaks").
SecretScanAvailable(idx) :- SecretScanVerdict(idx, "unavailable").
SecretScanAvailable(idx) :- SecretScanVerdict(idx, "unscannable").

// D) The scan found a secret in the commits being pushed. @ask rather than a
//    hard deny for the same reason as (C): a detector hit can be a false
//    positive and only the developer can tell. The daemon puts the rule, file,
//    line and commit in front of them; the secret itself is never quoted.
// @ask
// @deny_message: A secret scan of the commits this push would publish found a potential secret
// @suggestion: Rotate the credential and rewrite the commits that carry it; if it is a false positive, approve to push or add a .gitleaksignore entry
Unauthorized(idx) :- RuleEnabled("secret_scan"), IsPush(idx), SecretScanVerdict(idx, "leaks").

// E) The scanner could not run at all. Unverified is not the same as clean.
// @ask
// @deny_message: The commits this push would publish could not be scanned for secrets
// @suggestion: Install gitleaks so pushes are scanned automatically, or approve the push if the diff has already been checked
Unauthorized(idx) :- RuleEnabled("secret_scan"), IsPush(idx), SecretScanVerdict(idx, "unavailable").

// F) The scan could not COVER the range: a commit too large to scan, or a
//    finding withheld because it did not come back redacted. Distinct from
//    (E) — the scanner ran, and cannot vouch for part of what is being pushed.
//    This had no rule at all, so the verdict fell through to the transcript
//    evidence above, which is not scoped to a repository: a clean scan run in
//    another checkout satisfied it.
// @ask
// @deny_message: Part of what this push would publish could not be scanned for secrets
// @suggestion: Scan the range directly (`gitleaks git --log-opts=<base>..<ref>`) and confirm it is clean, or approve the push if it has already been checked
Unauthorized(idx) :- RuleEnabled("secret_scan"), IsPush(idx), SecretScanVerdict(idx, "unscannable").

/* ── 3. Prompt-injection exfiltration ──────────────────────────────── */

.decl UntrustedInContext()
UntrustedInContext() :- InContext(id), ToolResult(id, "WebFetch", _).
UntrustedInContext() :- InContext(id), ToolResult(id, "WebSearch", _).
UntrustedInContext() :- InContext(id), ToolResult(id, "RemoteAgent", _).

// Egress-program needles classified by the TOKEN scanner (@cmd_egress_class), not a
// raw substring: it distinguishes a program that actually RUNS (`curl …`, `sudo
// curl`, `sh -c 'curl'`, `ssh host cmd`) from the name appearing as inert DATA
// (`echo "curl …"`, a commit message, `grep "curl" f`) or as a whole-word non-match
// (`sync`/`async` are NOT `nc`). This kills the substring false positives while
// keeping the deny conservative — see @cmd_egress_class for the 0/1/2 contract
// (2 = runs → deny, 1 = present-but-unprovable → @ask, 0 = inert/absent → allow).
.decl ExfilProg(p: symbol)
ExfilProg("curl").   ExfilProg("wget").   ExfilProg("nc").    ExfilProg("ncat").
ExfilProg("netcat"). ExfilProg("scp").    ExfilProg("ssh").   ExfilProg("rsync").
ExfilProg("telnet"). ExfilProg("dig").    ExfilProg("nslookup").

// EXECUTED (class 2): a needle program runs at a command position → hard egress.
.decl ExfilExec(idx: unsigned)
ExfilExec(idx) :- ShellCommand(idx, cmd), ExfilProg(p), @cmd_egress_class(cmd, p) = 2.
// Interpreter HTTP clients — Python egress inside `python -c "…"`. The URL/verb
// lives in CODE, not a shell command position, so these stay high-signal substrings
// (they don't tokenize as shell commands). Matched on the normalized command.
ExfilExec(idx) :- ShellNorm(idx, n), @str_contains(n, "urlopen(") = 1.
ExfilExec(idx) :- ShellNorm(idx, n), @str_contains(n, "requests.") = 1.
ExfilExec(idx) :- ShellNorm(idx, n), @str_contains(n, "http.client") = 1.

// AMBIGUOUS (class 1): the needle NAME is present but execution can't be proven —
// variable indirection (`x=curl; $x`) or a bare-name arg to a possible unknown
// wrapper. Not provably egress, not provably inert → @ask (never a silent allow).
.decl ExfilMaybe(idx: unsigned)
ExfilMaybe(idx) :- ShellCommand(idx, cmd), ExfilProg(p), @cmd_egress_class(cmd, p) = 1.

// @deny_message: Outbound network command blocked — context depends on untrusted web-fetched content (possible prompt-injection exfiltration)
// @suggestion: Don't send data to the network while acting on fetched web content; if the send is intended, run it outside the agent
Unauthorized(idx) :- RuleEnabled("exfil"), ExfilExec(idx), UntrustedInContext().
// @ask
// @deny_message: Possible outbound command while untrusted web-fetched content is in context — a network tool's name appears but the command couldn't be confirmed to run it (e.g. via a variable)
// @suggestion: Approve when prompted only if this sends nothing to the network; otherwise drop the network step, or run it outside the agent
Unauthorized(idx) :- RuleEnabled("exfil"), ExfilMaybe(idx), UntrustedInContext().

/* ── 3b. Secret-bearing reads → egress (toxic-flow, hard deny) ─────── */
// Complements the untrusted-source rule above: block an outbound command when
// secret-bearing files (.env/.ssh) are in the current slice. Block the
// combination at the *sink* — never the read itself (utility). CVE-2025-55284.

// Secret-bearing paths and the read-ish verbs that pull them into context.
// Used for both the Read tool (file_path) and Bash (normalized command). The
// deny still requires an egress sink (ExfilExec/ExfilMaybe/WebEgress), so a broad
// match here stays conservative — it never blocks the read itself.
.decl SensitivePath(p: symbol)
SensitivePath(".env").  SensitivePath(".ssh/").  SensitivePath("id_rsa").
SensitivePath(".aws/credentials").  SensitivePath(".npmrc").  SensitivePath(".netrc").
.decl SensitiveReadVerb(v: symbol)
SensitiveReadVerb("cat ").   SensitiveReadVerb("head ").  SensitiveReadVerb("tail ").
SensitiveReadVerb("less ").  SensitiveReadVerb("more ").  SensitiveReadVerb("grep ").
SensitiveReadVerb("source "). SensitiveReadVerb("xxd "). SensitiveReadVerb("od ").
SensitiveReadVerb("strings ").

.decl SensitiveInContext()
SensitiveInContext() :- InContext(id), ToolResult(id, "Read", args),
    p = @json_get_str(args, "file_path"), SensitivePath(s), @str_contains(p, s) = 1.
// Bash that reads a secret path into context. Matched on the normalized command
// (catches `CAT`, extra whitespace) and any read verb, not just `cat … .env`.
SensitiveInContext() :- InContext(id), ToolResult(id, "Bash", args),
    cmd = @json_get_str(args, "command"), n = @normalize_cmd(cmd),
    SensitiveReadVerb(v), @str_contains(n, v) = 1,
    SensitivePath(s), @str_contains(n, s) = 1.

// @deny_message: Outbound command blocked — secret-bearing files (.env/.ssh) are in context (possible exfiltration)
// @suggestion: Don't send secrets to the network; if the send is intended, run the command outside the agent
Unauthorized(idx) :- RuleEnabled("toxic_flow"), ExfilExec(idx), SensitiveInContext().
// @ask
// @deny_message: Possible outbound command with secret-bearing files (.env/.ssh) in context — a network tool's name appears but the command couldn't be confirmed to run it (e.g. via a variable)
// @suggestion: Approve when prompted only if this sends no secrets; otherwise drop the send, or run the command outside the agent
Unauthorized(idx) :- RuleEnabled("toxic_flow"), ExfilMaybe(idx), SensitiveInContext().

// WebFetch is the tool-native egress channel (its URL/prompt can carry data
// out) — ExfilExec only sees Bash. A WebFetch with a secret in context is the
// read-secret→exfiltrate pattern (CVE-2025-55284 class). Scoped to
// SensitiveInContext (NOT UntrustedInContext) to avoid blocking ordinary
// chained browsing, where a prior WebFetch result is untrusted-in-context.
.decl WebEgress(idx: unsigned)
WebEgress(idx) :- Actions(idx, a), a = $CallTool("WebFetch", _).
// @deny_message: WebFetch blocked — secret-bearing files (.env/.ssh) are in context (possible exfiltration)
// @suggestion: Don't fetch URLs while secrets are in context; if the fetch is intended, run it outside the agent
Unauthorized(idx) :- RuleEnabled("toxic_flow"), WebEgress(idx), SensitiveInContext().

/* ── 4. Reverse-shell / remote-exec block (Tier-0, hard deny) ───────── */
// Tripwire, not a boundary — base64/$IFS obfuscation evades it (pairs with
// Claude Code's no-egress sandbox). High-signal literals only (SigmaHQ-style),
// collected into one relation so the denial carries a single message.

// Matched against the NORMALIZED command (case/spacing-insensitive), so
// `NC -E`, `/DEV/TCP`, `Socat ... EXEC:` are caught too. Needles lowercased.
.decl ReverseShell(idx: unsigned)
ReverseShell(idx) :- ShellNorm(idx, n), @str_contains(n, "/dev/tcp") = 1.
ReverseShell(idx) :- ShellNorm(idx, n), @str_contains(n, "/dev/udp") = 1.
ReverseShell(idx) :- ShellNorm(idx, n), @str_contains(n, "nc -e") = 1.
ReverseShell(idx) :- ShellNorm(idx, n), @str_contains(n, "nc -c") = 1.
ReverseShell(idx) :- ShellNorm(idx, n), @str_contains(n, "ncat -e") = 1.
ReverseShell(idx) :- ShellNorm(idx, n), @str_contains(n, "ncat --exec") = 1.
ReverseShell(idx) :- ShellNorm(idx, n), @str_contains(n, "mkfifo") = 1, @str_contains(n, "nc ") = 1.
ReverseShell(idx) :- ShellNorm(idx, n), @str_contains(n, "mkfifo") = 1, @str_contains(n, "ncat") = 1.
ReverseShell(idx) :- ShellNorm(idx, n), @str_contains(n, "socat") = 1, @str_contains(n, "exec:") = 1.
ReverseShell(idx) :- ShellNorm(idx, n), @str_contains(n, "socat") = 1, @str_contains(n, "system:") = 1.
// Python: the textbook reverse shell is os/pty-based, not subprocess — match the
// high-signal primitives directly (pty.spawn, os.dup2) plus the socket+subprocess form.
ReverseShell(idx) :- ShellNorm(idx, n), @str_contains(n, "import socket") = 1, @str_contains(n, "subprocess") = 1.
ReverseShell(idx) :- ShellNorm(idx, n), @str_contains(n, "pty.spawn") = 1.
ReverseShell(idx) :- ShellNorm(idx, n), @str_contains(n, "os.dup2") = 1, @str_contains(n, "socket") = 1.
// perl/ruby/php socket-exec one-liners, and the `-e <shell>` exec form used by
// busybox/traditional nc and others the `nc -e` literal misses.
ReverseShell(idx) :- ShellNorm(idx, n), @str_contains(n, "fsockopen(") = 1.
ReverseShell(idx) :- ShellNorm(idx, n), @str_contains(n, "-e /bin/sh") = 1.
ReverseShell(idx) :- ShellNorm(idx, n), @str_contains(n, "-e /bin/bash") = 1.

// @deny_message: Reverse-shell / remote-exec pattern blocked by policy
// @suggestion: Remove the shell-spawning network command; if it is legitimate, run it outside the agent
Unauthorized(idx) :- RuleEnabled("reverse_shell"), ReverseShell(idx).

/* ── 5. Config / hook persistence (Tier-0, hard deny) ──────────────── */
// Block the agent writing agent/editor config — a real in-the-wild persistence
// vector (SafeDep malicious hooks, wunderwuzzi). Covers the agent's edit tools
// (clean file_path) and Bash redirections to a config path.

.decl ConfigPathFrag(frag: symbol)
ConfigPathFrag(".claude/settings").
ConfigPathFrag(".claude/hooks").
ConfigPathFrag(".claude/commands").
ConfigPathFrag(".claude/agents").
// The TRANSCRIPTS, which are not configuration but are the guard's evidence.
// Everything the transcript-derived rules know comes from these files: whether
// a gitleaks run happened and was clean, whether untrusted content is in
// context, whether a review ran, which files were edited. An agent able to
// write its own transcript can assert any of that — insert a clean scan result,
// drop the tool_result that carries taint, fabricate a review launch — and the
// gates that read it agree. Blocked at the same tier as hook persistence,
// because forging the evidence is at least as direct as installing a hook.
//
// `.claude/projects/` only. `.claude/todos/` and the rest of the directory are
// the agent's own working state and it writes them routinely.
ConfigPathFrag(".claude/projects").
ConfigPathFrag(".claude.json").
// Codex CLI: its config (a project's `.codex/config.toml` can turn hooks off),
// its hooks (the sasy-guard hook among them), and its session files, which the
// daemon reads as the session's history.
ConfigPathFrag(".codex/config").
ConfigPathFrag(".codex/hooks").
ConfigPathFrag(".codex/sessions").
ConfigPathFrag(".mcp.json").
ConfigPathFrag(".cursor/rules").
ConfigPathFrag(".github/copilot-instructions").
// Generic auto-exec persistence vectors (not agent-specific). Scope .vscode to
// the task/debug-runner files (auto-exec), NOT all of .vscode/ — editing
// .vscode/settings.json or extensions.json is routine and shouldn't hard-deny.
ConfigPathFrag(".git/hooks/").
ConfigPathFrag(".vscode/tasks.json").
ConfigPathFrag(".vscode/launch.json").
ConfigPathFrag(".envrc").

.decl EditTarget(idx: unsigned, path: symbol)
EditTarget(idx, p) :- Actions(idx, a), a = $CallTool("Edit", args), p = @json_get_str(args, "file_path").
EditTarget(idx, p) :- Actions(idx, a), a = $CallTool("Write", args), p = @json_get_str(args, "file_path").
EditTarget(idx, p) :- Actions(idx, a), a = $CallTool("MultiEdit", args), p = @json_get_str(args, "file_path").
EditTarget(idx, p) :- Actions(idx, a), a = $CallTool("NotebookEdit", args), p = @json_get_str(args, "notebook_path").

// The TRANSCRIPT is matched differently from the rest: ANY command naming it
// counts, with no verb list. The list below (redirect / tee / sed -i / cp / mv
// / ln) is a reasonable filter for configuration files, where `cat` is routine
// and a write needs one of a few shapes — but it has no end for a path whose
// content is the guard's own evidence. `python -c 'open(p,"w")'`, `truncate`,
// `perl -pi` and plain `rm` all name the file and none contain a listed verb.
// This is the same reasoning the guard-home rules already state: enumerate the
// verbs and the list is always missing one, so match the PATH instead and
// accept that reading it asks too. Nobody has a routine reason to touch their
// own transcript.
.decl TranscriptFrag(frag: symbol)
// NO trailing slash, for the reason the guard-home rule above already gives:
// with one, the DIRECTORY itself is invisible. `rm -rf ~/.claude/projects`
// destroys every transcript and never contains `.claude/projects/`, and
// `cd ~/.claude/projects && echo >> s.jsonl` writes one by a relative path that
// never names it at all. I wrote the slash anyway; the lesson was already
// recorded eight lines up.
TranscriptFrag(".claude/projects").
TranscriptFrag(".codex/sessions").

.decl TouchesConfig(idx: unsigned)
TouchesConfig(idx) :- ShellCommand(idx, cmd), TranscriptFrag(f), @str_contains(cmd, f) = 1.
TouchesConfig(idx) :- ShellNorm(idx, n), TranscriptFrag(f), @str_contains(n, f) = 1.
TouchesConfig(idx) :- EditTarget(idx, p), ConfigPathFrag(f), @str_contains(p, f) = 1.
// ...and case-insensitively. macOS filesystems are case-insensitive, so
// `/Users/x/.CLAUDE/projects/s.jsonl` IS the transcript; and the guard-home
// fragment is seeded lowercased for the Bash side, which left the edit tools
// unable to match a mixed-case home at all.
TouchesConfig(idx) :- EditTarget(idx, p), ConfigPathFrag(f),
    @str_contains(@normalize_cmd(p), f) = 1.
// Bash writes: a config path together with a write operator (redirect/tee/sed -i/cp/mv/ln).
TouchesConfig(idx) :- ShellCommand(idx, cmd), ConfigPathFrag(f), @str_contains(cmd, f) = 1, @str_contains(cmd, ">") = 1.
TouchesConfig(idx) :- ShellCommand(idx, cmd), ConfigPathFrag(f), @str_contains(cmd, f) = 1, @str_contains(cmd, "tee ") = 1.
TouchesConfig(idx) :- ShellCommand(idx, cmd), ConfigPathFrag(f), @str_contains(cmd, f) = 1, @str_contains(cmd, "sed -i") = 1.
TouchesConfig(idx) :- ShellCommand(idx, cmd), ConfigPathFrag(f), @str_contains(cmd, f) = 1, @str_contains(cmd, "cp ") = 1.
TouchesConfig(idx) :- ShellCommand(idx, cmd), ConfigPathFrag(f), @str_contains(cmd, f) = 1, @str_contains(cmd, "mv ") = 1.
TouchesConfig(idx) :- ShellCommand(idx, cmd), ConfigPathFrag(f), @str_contains(cmd, f) = 1, @str_contains(cmd, "ln ") = 1.

// ...and the same against the NORMALIZED command. The fragments are lowercase
// and the raw form is not, so `.CLAUDE/settings.json` — the same file on a
// case-insensitive filesystem — matched none of the rules above.
TouchesConfig(idx) :- ShellNorm(idx, cmd), ConfigPathFrag(f), @str_contains(cmd, f) = 1, @str_contains(cmd, ">") = 1.
TouchesConfig(idx) :- ShellNorm(idx, cmd), ConfigPathFrag(f), @str_contains(cmd, f) = 1, @str_contains(cmd, "tee ") = 1.
TouchesConfig(idx) :- ShellNorm(idx, cmd), ConfigPathFrag(f), @str_contains(cmd, f) = 1, @str_contains(cmd, "sed -i") = 1.
TouchesConfig(idx) :- ShellNorm(idx, cmd), ConfigPathFrag(f), @str_contains(cmd, f) = 1, @str_contains(cmd, "cp ") = 1.
TouchesConfig(idx) :- ShellNorm(idx, cmd), ConfigPathFrag(f), @str_contains(cmd, f) = 1, @str_contains(cmd, "mv ") = 1.
TouchesConfig(idx) :- ShellNorm(idx, cmd), ConfigPathFrag(f), @str_contains(cmd, f) = 1, @str_contains(cmd, "ln ") = 1.

// @deny_message: Writing agent/editor config (hooks, MCP servers, rules) is blocked — a known persistence vector
// @suggestion: Edit project source instead; agent/editor settings have to be changed outside the agent session
Unauthorized(idx) :- RuleEnabled("config_persistence"), TouchesConfig(idx).

/* ── 5b. sasy-guard's own installation (Tier-1, @ask) ───────────────── */
// The rules above protect the HOST agent's config. This one protects the guard
// itself: everything under the guard home (~/.sasy by default) — config.json,
// the baked policies and their manifest, the binaries, the credential store.
//
// It is the shortest path around every other gate in this file. config.json
// alone carries `failMode` (flip it to "open" and an unreachable engine allows
// instead of denies), `ruleOff` (name a group and it stops running), `endpoint`
// (point the daemon at something that says yes), and `policyProfile` (bind
// deny-all's opposite). Rewriting security.dl, or replacing the binary in
// bin/, ends enforcement outright. None of that is reachable through the
// config_persistence paths above, which cover `.claude/…` and editor config.
//
// SOFT (@ask), not a hard deny, because reconfiguring the guard is a legitimate
// thing to ask an agent to do — including in this repository, where changing a
// threshold and reinstalling is ordinary work. The value is that it cannot
// happen SILENTLY: an edit here surfaces as a confirmation naming the file. A
// hard deny would push the work outside the session without making the change
// any more visible. Turning the group off (`ruleOff: ["guard_config"]`) is
// itself an edit to config.json, so it asks once before it can take effect.
//
// LIMITS. This gates the guard's FILES, not every route to the same outcome:
//   · A `sasy-watch setup` re-run, an env override (SASY_HOME, SASY_FAIL_OPEN)
//     or killing the daemon reconfigure enforcement without writing these paths.
//   · The Bash side asks on ANY command naming a guard path, reads included, so
//     `cat ~/.sasy/config.json` asks. Over-asking is the safe direction here and
//     the prompt names the file.
//   · The path is matched as a substring of the command text, so ordinary shell
//     word construction hides it: `~/.sa""sy/config.json` and `~/.sa'sy'/…` both
//     resolve to the guard home while the literal `.sasy` never appears. That is
//     the general limit of substring matching over shell text (issue #196) and it
//     applies to `config_persistence` above in exactly the same way; the
//     tokenizer is a tripwire here, not a soundness boundary.
.decl GuardHomeFrag(frag: symbol)
// The leading DOT is what distinguishes the guard home from an ordinary folder:
// a project directory that merely ends in `sasy` (this repository's own
// `SASY/sasy/…`) has no dot before it and cannot match. No trailing slash — with
// one, the directory ITSELF was invisible, so `rm -rf ~/.sasy`, `mv ~/.sasy
// /tmp/off` and `chmod 000 ~/.sasy` removed or disabled the entire installation
// without asking, which is the loudest version of what this group exists to
// catch. Matching without the slash also covers a sibling like `.sasy-old`,
// which is over-asking rather than under.
GuardHomeFrag(".sasy").
// ...and wherever the guard ACTUALLY lives, which the daemon sends as an
// absolute path. `.sasy` alone protects only the default location: under
// `SASY_HOME=/opt/sasy` the literal never appears, so rewriting the controlling
// config was not escalated at all. Both facts hold, so a non-default install is
// covered without weakening the default.
GuardHomeFrag(frag) :- PolicyMetadata("guard_home_frag", frag, _).

// Bash side: naming a guard path in a shell command asks, with NO exemption for
// reading. Two narrower shapes were tried first and both failed in the same way.
//
// Listing the write verbs and firing on those is the wrong way round: the list
// has no end (`install -m755 … ~/.sasy/bin/sasy`, `dd of=~/.sasy/config.json`,
// `rsync`, `perl -pi -e`, `python -c`, an editor in batch mode), and every verb
// missing from it silently REPLACES the binary or the policy.
//
// Inverting that — ask by default, exempt a single simple command running one of
// a short list of inspection tools — is the right direction but could not be made
// sound. The exemption sprang a hole every time it was examined: `find … -delete`
// deletes, `less -O out` writes its input to a file, `more` is `less` on several
// systems, GNU `diff --output=FILE` writes, `file -C -m src` compiles a magic
// file. Each of those reads like an inspection tool, so the list can only be
// trusted after reading every flag of every entry, and one wrong entry costs the
// group. The last one settled it: `@cmd_invokes` only reports that a read verb
// appears SOMEWHERE, and ShellNorm collapses a newline to a space, so a two-line
// script — `cat ~/.sasy/config.json` then `rm ~/.sasy/config.json` — satisfied
// every condition while deleting the file. There is no newline left to test for
// at that point, and no primitive here counts commands.
//
// So reading the guard's own files asks too. That costs one confirmation on an
// uncommon action, and buys a rule with no exemption left to attack. The edit
// tools stay narrower only in that they match the tool's declared `file_path`
// rather than a whole command line — both sides match the path as TEXT, so the
// boundary is approximate in the harmless direction as well: a neighbouring
// `/tmp/.sasy-backup/` or a file named `notes.sasy.txt` asks too.
.decl TouchesGuardConfig(idx: unsigned)
TouchesGuardConfig(idx) :- EditTarget(idx, p), GuardHomeFrag(f), @str_contains(p, f) = 1.
TouchesGuardConfig(idx) :- EditTarget(idx, p), GuardHomeFrag(f),
    @str_contains(@normalize_cmd(p), f) = 1.
// Matched against the NORMALIZED command, so a `\`+newline continuation cannot
// split the path out of recognition and the match is case-insensitive.
TouchesGuardConfig(idx) :- ShellNorm(idx, n), GuardHomeFrag(f), @str_contains(n, f) = 1.

// @ask
// @deny_message: Touching sasy-guard's own installation (config, policy, or binary under ~/.sasy) — this is what decides whether every other check runs. Shell commands are asked about even when they only read, because reading and writing cannot be told apart reliably in a command line
// @suggestion: Approve when prompted only if you asked for this; otherwise edit ~/.sasy directly rather than through the agent
Unauthorized(idx) :- RuleEnabled("guard_config"), TouchesGuardConfig(idx).

// A project's own `.sasy/` directory — `project.json` (what the scan gate
// excludes and which severities gate) and `overrides.json` (findings a person
// accepted) — is guard configuration that lives in the repository. The daemon
// reads it from HEAD, never from the working tree, so changing it means
// committing it; and a push that carries such a commit asks here, so the change
// is seen by a person before it governs the remote. The edit itself already
// asked above (`.sasy` is in the path); this catches the routes that name no
// path — `git apply`, a checkout, a script — at the moment the change leaves
// the machine.
.decl SastProjectChanged(idx: unsigned, path: symbol)
SastProjectChanged(idx, path) :- ActionMetadata(idx, "sast_project_changed", path, _).

// @ask
// @deny_message: This push changes the project's .sasy/ configuration, which decides what the scan gate excludes, overrides, and blocks
// @suggestion: Approve when prompted only if the change to .sasy/ was reviewed and is intended; the committed version takes effect from the next session on
Unauthorized(idx) :- RuleEnabled("guard_config"), IsPush(idx), SastProjectChanged(idx, _).

/* ── 6. Agent-redirect environment variables (Tier-0, hard deny) ───── */
// Setting the API base URL / auth token redirects the agent to an attacker
// endpoint (CVE-table #13). Near-zero benign use inside a session.

// Matched against the NORMALIZED (lowercased) command, so one needle catches
// both HTTP_PROXY= and http_proxy=, ANTHROPIC_API_KEY= and any casing.
.decl AgentRedirect(idx: unsigned)
// Any *_base_url= override points the model client at an attacker endpoint
// (covers anthropic_/openai_/bedrock/vertex and future providers in one catch-all).
AgentRedirect(idx) :- ShellNorm(idx, n), @str_contains(n, "_base_url=") = 1.
AgentRedirect(idx) :- ShellNorm(idx, n), @str_contains(n, "anthropic_auth_token=") = 1.
AgentRedirect(idx) :- ShellNorm(idx, n), @str_contains(n, "anthropic_api_key=") = 1.
// Proxy overrides route ALL agent egress through an attacker MITM — same effect
// as a base-URL redirect.
AgentRedirect(idx) :- ShellNorm(idx, n), @str_contains(n, "http_proxy=") = 1.
AgentRedirect(idx) :- ShellNorm(idx, n), @str_contains(n, "https_proxy=") = 1.
AgentRedirect(idx) :- ShellNorm(idx, n), @str_contains(n, "all_proxy=") = 1.
// CA-bundle / TLS-trust overrides enable a silent TLS MITM of agent traffic.
AgentRedirect(idx) :- ShellNorm(idx, n), @str_contains(n, "node_extra_ca_certs=") = 1.
AgentRedirect(idx) :- ShellNorm(idx, n), @str_contains(n, "requests_ca_bundle=") = 1.
AgentRedirect(idx) :- ShellNorm(idx, n), @str_contains(n, "curl_ca_bundle=") = 1.
AgentRedirect(idx) :- ShellNorm(idx, n), @str_contains(n, "ssl_cert_file=") = 1.
AgentRedirect(idx) :- ShellNorm(idx, n), @str_contains(n, "node_tls_reject_unauthorized=") = 1.

// @deny_message: Overriding the agent's API endpoint / token via the environment is blocked
// @suggestion: Do not set ANTHROPIC_BASE_URL / AUTH_TOKEN / OPENAI_BASE_URL from within the agent
Unauthorized(idx) :- RuleEnabled("agent_redirect"), AgentRedirect(idx).

/* ── 7. curl|sh pipe-to-interpreter → confirm (Tier-1, @ask) ────────── */
// FP-prone (rustup/homebrew/nvm installers), so soft: @ask unless the URL host
// is allowlisted via PolicyMetadata("trusted_domain", …). Empty allowlist ⇒
// every curl|sh prompts for confirmation.

.decl TrustedDomain(d: symbol)
TrustedDomain(d) :- PolicyMetadata("trusted_domain", d, _).

// Matched against the NORMALIZED command (`CURL … | SH` caught too). The fetch
// verb and interpreter must co-occur; command-substitution install forms have
// no literal pipe.
.decl PipeToInterp(idx: unsigned)
PipeToInterp(idx) :- ShellNorm(idx, n), @str_contains(n, "curl") = 1, @str_contains(n, "| sh") = 1.
PipeToInterp(idx) :- ShellNorm(idx, n), @str_contains(n, "curl") = 1, @str_contains(n, "| bash") = 1.
PipeToInterp(idx) :- ShellNorm(idx, n), @str_contains(n, "curl") = 1, @str_contains(n, "|sh") = 1.
PipeToInterp(idx) :- ShellNorm(idx, n), @str_contains(n, "curl") = 1, @str_contains(n, "|bash") = 1.
PipeToInterp(idx) :- ShellNorm(idx, n), @str_contains(n, "curl") = 1, @str_contains(n, "| python") = 1.
PipeToInterp(idx) :- ShellNorm(idx, n), @str_contains(n, "curl") = 1, @str_contains(n, "|python") = 1.
PipeToInterp(idx) :- ShellNorm(idx, n), @str_contains(n, "wget") = 1, @str_contains(n, "| sh") = 1.
PipeToInterp(idx) :- ShellNorm(idx, n), @str_contains(n, "wget") = 1, @str_contains(n, "| bash") = 1.
PipeToInterp(idx) :- ShellNorm(idx, n), @str_contains(n, "wget") = 1, @str_contains(n, "|sh") = 1.
PipeToInterp(idx) :- ShellNorm(idx, n), @str_contains(n, "wget") = 1, @str_contains(n, "|bash") = 1.
// Command-substitution install forms (Homebrew/oh-my-zsh/rustup style): no pipe.
PipeToInterp(idx) :- ShellNorm(idx, n), @str_contains(n, "$(curl") = 1.
PipeToInterp(idx) :- ShellNorm(idx, n), @str_contains(n, "$(wget") = 1.
PipeToInterp(idx) :- ShellNorm(idx, n), @str_contains(n, "<(curl") = 1.
PipeToInterp(idx) :- ShellNorm(idx, n), @str_contains(n, "<(wget") = 1.

// Match the URL's *registrable domain* (eTLD+1) against the allowlist — not a
// substring of the command. Blocks subdomain confusion (rustup.rs.evil.com →
// evil.com) and path confusion (evil.com/rustup.rs → evil.com). TrustedDomain
// entries are therefore registrable domains (e.g. "rustup.rs", "sh.rs").
// Host extraction uses the RAW cmd (registrable_domain lowercases internally).
// Trust requires a SINGLE fetch URL: `@registrable_domain` only reads the first
// host, so `curl TRUSTED && curl evil | sh` (two `://`) must not inherit trust.
.decl FromTrustedHost(idx: unsigned)
FromTrustedHost(idx) :-
    PipeToInterp(idx), ShellCommand(idx, cmd),
    @count_urls(cmd) < 2,
    rd = @registrable_domain(cmd), rd != "", TrustedDomain(rd).

// The reason NAMES the registrable domain, for two reasons. A prompt that says
// "an unrecognized source" without saying which one asks the user to judge
// something it did not show them. And the daemon reads that name back to offer
// "trust it for this session" — @registrable_domain is the ONLY implementation
// of eTLD+1 here (a curated multi-label suffix set over a last-two-labels rule),
// so having the daemon derive its own would be a second copy that can disagree;
// a naive last-two-labels copy reduces foo.co.uk to co.uk and trusts a whole
// TLD. The value the reason states is by construction the value TrustedDomain
// compares against, which is what makes the round-trip safe.
//
// Two rules, not one with a disjunctive body: `( … ; … )` is outside the
// checkable Datalog fragment and the checker's front end refuses it outright.
DenialReason(idx, "ask",
  cat("Piping a downloaded script straight into a shell (curl|sh) from an unrecognized source (",
      cat(rd, ")")),
  "Download and read the script before running it; approve when prompted only if this is a trusted installer") :-
    RuleEnabled("curl_sh"), PipeToInterp(idx), !FromTrustedHost(idx),
    ShellCommand(idx, cmd), rd = @registrable_domain(cmd), rd != "".

// No URL the domain extractor could name (a piped fetch it can't parse): ask
// with the original wording, and the daemon simply finds nothing to offer.
DenialReason(idx, "ask",
  "Piping a downloaded script straight into a shell (curl|sh) from an unrecognized source",
  "Download and read the script before running it; approve when prompted only if this is a trusted installer") :-
    RuleEnabled("curl_sh"), PipeToInterp(idx), !FromTrustedHost(idx),
    ShellCommand(idx, cmd), @registrable_domain(cmd) = "".

/* ── 8. Hidden Unicode tags (Tier-0, taint source → @ask) ──────────── */
// Invisible Tags-block text (U+E0000–U+E007F) is a prompt-injection carrier. It
// is a property of a *dependency* (an upstream tool result the agent read), not
// of the current action — so taint the SOURCE and confirm any action that
// transitively depends on it, surfacing the decoded hidden text. The user's
// decision is remembered (projected from policy metadata, daemon-recorded):
// approve clears the source (detaint), deny hard-blocks it.

// Any source carrying invisible / display-deceptive Unicode — not just the
// Tags block, but also bidi overrides (Trojan Source), interlinear annotation,
// and variation-selector byte smuggling. Tag-block text is additionally
// decodable and surfaced verbatim below.
// Scattered payload-free format chars (a stray BOM in a fetched file, one ZWSP
// at a word boundary in copied web text, soft hyphens in HTML prose) do NOT
// taint the source: @deceptive_unicode_class returns 1 only past the harmless
// bound (more than 4, or two in one contiguous invisible run — adjacent, or
// separated only by invisible chars that are in no class; any VISIBLE char
// breaks the run) and 2 for every class that stays dangerous with an empty
// decode. "In no class" is the default-ignorable PROPERTY, not a list of
// codepoints, in both the run test and the volume tally below — otherwise an
// unlisted invisible could be interleaved to break a blob the reader sees
// unbroken, or used as padding no tally counts. The variation-selector channel
// reads a run the same way: two selectors in one invisible blob, however many
// invisibles sit between them. A large VOLUME of blank characters taints on its
// own — more than 256 class-free invisibles IN RUNS of two or more (the Braille
// blank, the Hangul fillers, ZWJ/ZWNJ, the bidi marks, and every other codepoint
// that renders as nothing; a lone one is ordinary in Persian/Arabic/Indic text
// and displaces nothing, so only a contiguous wall counts). They carry nothing individually, which is why each one is
// exempt above, but a wall of them pushes earlier content out of the window the
// agent can still see and pads a message past where a human skimming it stops
// reading. Word POSITION is deliberately NOT a trigger: a format char between
// two letters ("previ"+ZWSP+"ous instructions") looks like intent, but a split
// in a SOURCE subverts nothing here. Splitting only defeats a LITERAL match,
// and every substring test this policy runs over message CONTENTS is
// presence-based — the GitleaksRun/GitleaksClean/OsvClean markers, which UNLOCK
// a gate — so a split makes them fail to match and the gate stays SHUT. The
// substring tests a split COULD subvert run over the ACTION, and the command
// sink rule at the end of this section keeps the strict per-char test there.
// SCOPED, not universal: the policy does run two ABSENCE tests over a source
// node's ARGS — ReviewArtifact's `@str_contains(st, "preview") = 0` exclusions
// below — and a split there ("p"+ZWSP+"review-deploy") passes the exclusion. It
// buys nothing today (naming the subagent "code-review" credits a review just
// as well, no split needed), but a future absence test that actually gates
// something cannot lean on this exemption.
// LIMIT: a visible injected instruction on a fetched page is not covered — but
// it never was, and is not covered on a page carrying no invisible char either;
// what arms against it is the page being untrusted context (public_push/exfil).
// Nor is the HINT reported: an in-word format char is weak evidence the text was
// worked on deliberately, and below the bound that evidence is dropped. Traded
// on purpose — a split RENDERS as the unsplit word, so the instruction it
// decorates is in plain sight to reader and model alike, and reporting the hint
// costs a prompt on ordinary copied prose.
// Gated on the source so the whole group (label, @ask, deny) cascades off AND
// the per-message unicode scan is skipped when disabled. NOTE: the @ask
// DenialReason and the DetaintDenied deny below inherit this gate transitively
// (they join on HiddenUnicodeSource) — they carry no explicit RuleEnabled. Any
// future producer of HiddenUnicodeSource MUST also gate on
// RuleEnabled("hidden_unicode") or the group becomes un-disablable.
.decl HiddenUnicodeSource(id: symbol)
HiddenUnicodeSource(id) :- RuleEnabled("hidden_unicode"), SentMessage(id, m), @deceptive_unicode_class(m.contents) >= 1.

// Remembered detaint decisions (node-bound), projected from policy metadata.
.decl DetaintApproved(node: symbol)
DetaintApproved(n) :- PolicyMetadata("detaint_approved", n, _).
.decl DetaintDenied(node: symbol)
DetaintDenied(n) :- PolicyMetadata("detaint_denied", n, _).

// Undecided source the current action depends on → @ask, describing what the
// source carries. Written as DenialReason directly so the message can carry the
// functor-built description ("ask" kind does not derive Unauthorized, so the
// action stays allow-but-confirm).
// The prompt shows @deceptive_unicode_summary, not the raw decode: the decode is
// EMPTY for every class that hides no readable text — a bidi override, bulk
// blank padding, a Tags framing char — so a prompt built from it alone told the
// user nothing was found in exactly the cases it was firing on. The summary
// names each class with an exact count and its dominant codepoint, and carries
// the decoded Tags text verbatim when there is any.
// Label the source by its provenance — the tool that produced it, when known.
.decl HiddenSourceHasTool(s: symbol)
HiddenSourceHasTool(s) :- HiddenUnicodeSource(s), ToolResult(s, _, _).
.decl HiddenSourceLabel(s: symbol, label: symbol)
HiddenSourceLabel(s, label) :- HiddenUnicodeSource(s), ToolResult(s, fn, _), label = cat(cat("a ", fn), " result").
HiddenSourceLabel(s, "upstream content") :- HiddenUnicodeSource(s), !HiddenSourceHasTool(s).

// Pure user-interaction tools only surface a prompt/choices to the user — no
// exfil, no file/command side effect — so the hidden-unicode gates never apply
// to them. Critically, the agent uses AskUserQuestion to present THIS gate's own
// approval menu: gating it would deadlock (the agent can't ask the question that
// resolves the gate). ExitPlanMode is likewise a display-only tool.
.decl InteractionTool(idx: unsigned)
InteractionTool(idx) :- Actions(idx, a), a = $CallTool("AskUserQuestion", _).
InteractionTool(idx) :- Actions(idx, a), a = $CallTool("ExitPlanMode", _).

DenialReason(idx, "ask", reason,
             "Approve ONLY if this hidden text is benign (remembered as a detaint for this source). If it looks malicious, do NOT approve — revert the session to before the message that introduced it, since the agent has already read it.") :-
    Actions(idx, _), !InteractionTool(idx), InContext(s), HiddenUnicodeSource(s),
    !DetaintApproved(s), !DetaintDenied(s),
    HiddenSourceLabel(s, label), SentMessage(s, m), summary = @deceptive_unicode_summary(m.contents),
    reason = cat("Invisible or display-deceptive Unicode in ",
                 cat(label, cat(" — the agent reads it as text you may not see. Found: ", summary))).

// A source the user already rejected → hard block (deny, no re-ask). The
// !DetaintApproved guard makes an explicit approval authoritative: a later deny
// (e.g. a mis-scoped one) can't silently revoke a source the user vouched for.
//
// Scoped to InContext(s) — Current ∪ CurrentDepends — which MUST be the same
// scope the @ask above uses. It was CurrentDepends alone (dependency
// reachability, excluding the frontier itself), to avoid blocking a concurrent
// subagent that never read the tainted data, since the daemon's frontier is a
// union across threads. But the ask is suppressed by !DetaintDenied(s) at the
// WIDER scope, so on the difference between the two — a denied source sitting in
// the frontier rather than strictly upstream of it — the ask went quiet and this
// deny never fired: the action was ALLOWED. Answering "malicious" was therefore
// strictly more permissive than not answering at all, and it went that way in the
// case that matters most, the first action after a poisoned tool result lands.
// A narrower deny than the ask is unsound whenever the ask defers to it; the
// over-blocking that motivated the narrow scope is the correct trade against a
// verdict the user made deliberately, and it is bounded — CurrentDepends still
// carries the block down the dependency chain, and a reverted branch still drops
// it, because a source that leaves the context leaves InContext too.
// @deny_message: Acting on content from a hidden-text source that was rejected earlier
// @suggestion: This source was rejected; clearing it needs the session rewound to before the message that introduced it
Unauthorized(idx) :- Actions(idx, _), !InteractionTool(idx), InContext(s), HiddenUnicodeSource(s),
    DetaintDenied(s), !DetaintApproved(s).

// Sink rule (Tier-1, @ask) — display-deceptive Unicode in the command the agent
// is about to RUN, as opposed to the Tier-0 taint source above. This is what
// makes the source-side exemption safe: inside a command a single format char
// splits a needle ("cu" + ZWSP + "rl" defeats @str_contains) and has no place in
// a command anyone meant to type, so the strict per-char @has_deceptive_unicode
// applies here, NOT the class threshold. Independent of the taint flow: it fires
// on the action itself, with no source, dependency, or detaint involved.
// SCOPE: @has_deceptive_unicode's low-FP exclusions apply here too — ZWJ/ZWNJ
// (U+200C/U+200D), the bidi marks (U+200E/U+200F/U+061C), a lone presentation
// selector (U+FE00–FE0F), the Braille blank (U+2800), the Hangul fillers
// (U+115F/U+1160/U+3164/U+FFA0) and the other class-free invisibles are
// invisible but do NOT fire the strict test on their own: one of them in a
// command is a strange space, not an attack, and tainting it is a false
// positive. Their VOLUME is a different matter, so the SECOND rule below adds
// the same bulk-padding trigger the source rule uses (@deceptive_unicode_class
// = 1 for more than 256 of them sitting in RUNS of two or more). Without it a
// command could carry a wall of blanks and be allowed with no prompt at all —
// pushing what actually runs out of the host's own raw command preview, which
// SASY does not render. Once a prompt IS shown, SASY's copy is safe by
// construction: promptSafeText names and collapses every invisible character
// and spends its length budget on visible ones only.
// The class threshold is used ONLY as this extra trigger; it never relaxes the
// strict test, so a single format char in a command still @asks.
//
// TWO RULES for one helper relation, not one rule with a disjunctive body:
// `( A ; B )` is outside the checkable Datalog fragment — the translation
// checker's front end (packages/policy-ir) refuses it as a "disjunctive rule
// body" — and this verdict rule is one of the rules that front end admits, so
// it must stay inside the fragment. Two rules for one relation ARE the
// disjunction, in the fragment. The verdict-rule count is unchanged:
// DeceptiveCommand derives no DenialReason of its own.
// Both helper rules carry the group gate so a disabled group does no scanning
// at all (the verdict rule keeps its own copy, so the gate is visible on the
// rule it gates).
.decl DeceptiveCommand(idx: unsigned)
DeceptiveCommand(idx) :- RuleEnabled("hidden_unicode"), ShellCommand(idx, cmd), @has_deceptive_unicode(cmd) = 1.
DeceptiveCommand(idx) :- RuleEnabled("hidden_unicode"), ShellCommand(idx, cmd), @deceptive_unicode_class(cmd) >= 1.
// …and the class-free invisibles, but only where they are CODE. One of them in a
// command's data is a strange space in an echo argument — the false positive the
// exemption exists for — while one in a program name disguises what runs: a repo
// can ship an executable named `cu<U+200D>rl`, which reads as curl to whoever
// skims the transcript, executes, and matches neither the curl gate (it looks for
// the literal "curl") nor the strict test (which passes over U+200D). Quoted
// regions and here-doc bodies are data; a substitution inside double quotes is
// code. See issue #282.
DeceptiveCommand(idx) :- RuleEnabled("hidden_unicode"), ShellCommand(idx, cmd), @cmd_hidden_in_code(cmd) = 1.

// @ask
// @deny_message: Invisible Unicode characters inside a shell command — they can disguise what actually runs or defeat pattern checks
// @suggestion: Re-enter the command without the hidden characters instead of copying it from the source
Unauthorized(idx) :- RuleEnabled("hidden_unicode"), DeceptiveCommand(idx), !InteractionTool(idx).

/* ── 9. Public push / issue while tainted (Tier-1, @ask) ───────────── */
// Pushing/posting to a PUBLIC repo while untrusted or secret-bearing content is
// in context is the nx s1ngularity exfil pattern (injected instructions → data
// to an attacker-readable location). The daemon resolves repo visibility (origin
// remote + GitHub API) and asserts `repo_public`; gated on a tainted context so
// ordinary public-repo work is unaffected.

.decl RepoIsPublic()
RepoIsPublic() :- ActionMetadata(_, "repo_public", "true", _).

.decl TaintedContext()
TaintedContext() :- UntrustedInContext().
TaintedContext() :- SensitiveInContext().

.decl IsRepoSink(idx: unsigned)
IsRepoSink(idx) :- IsPush(idx).  // a git push IS a repo sink — same @cmd_runs_sub definition as the secret_scan/review push gate (no more disagreement / commit-message FP)
IsRepoSink(idx) :- ShellCommand(idx, cmd), @str_contains(cmd, "gh ") = 1, @str_contains(cmd, "issue create") = 1.
IsRepoSink(idx) :- ShellCommand(idx, cmd), @str_contains(cmd, "gh ") = 1, @str_contains(cmd, "pr create") = 1.
// Comments/reviews are an exfil channel too — their body posts to the repo.
IsRepoSink(idx) :- ShellCommand(idx, cmd), @str_contains(cmd, "gh ") = 1, @str_contains(cmd, "issue comment") = 1.
IsRepoSink(idx) :- ShellCommand(idx, cmd), @str_contains(cmd, "gh ") = 1, @str_contains(cmd, "pr comment") = 1.
IsRepoSink(idx) :- ShellCommand(idx, cmd), @str_contains(cmd, "gh ") = 1, @str_contains(cmd, "pr review") = 1.

// @ask
// @deny_message: Pushing/posting to a PUBLIC repo while untrusted or secret-bearing content is in context (possible exfiltration to an attacker-readable location)
// @suggestion: Push to a private remote instead; approve when prompted only if this destination is trusted and intended
Unauthorized(idx) :- RuleEnabled("public_push"), IsRepoSink(idx), RepoIsPublic(), TaintedContext().

/* ── 10. Security-review gate on push (Tier-1, @ask) ───────────────── */
// Require a code/security-review artifact in the slice before a push — a
// reliably-detectable tool_use node (a review subagent or a review skill).
// Replaces mandatory SAST. Soft (@ask) on purpose: artifact *existence* is
// deterministic, but review *quality* is LLM-backed, so don't hard-gate on it.

// A review artifact node — a code/security-review subagent or a review skill.
// Excludes "preview" so a preview-deploy tool can't pose as a review (mirrors
// isReviewArtifact in review-diff.ts — keep the two in sync).
// NOTE for anyone extending these: the "preview" tests are ABSENCE tests over a
// SOURCE node's args, the one shape the hidden-unicode source exemption does not
// cover — "p"+ZWSP+"review-deploy" passes the exclusion, and the Bash command
// sink does not see tool args. Harmless here (any name containing "review"
// credits an artifact anyway, so a split gains nothing), but a NEW exclusion
// that actually decides a gate needs its own defence.
.decl ReviewArtifact(id: symbol)
// The subagent-LAUNCH tools, each carrying `subagent_type`. Named `Agent` in this
// host and `Task` / `TaskCreate` / `TaskRun` in others; the daemon's isReviewArtifact
// (review-diff.ts) recognizes all four, so mirror the SAME set here or a review
// launched via TaskCreate/TaskRun would fail to credit ReviewedEdit on the
// transcript-fallback path and re-gate an already-reviewed push. Factored into one
// relation so the tool set lives in a single place — the prior per-tool duplication
// is what let this list drift out of sync. (Exact names, where the daemon
// prefix-matches taskcreate*/taskrun*; over-gating an exotic variant is the safe
// direction, and a new name is a one-line add. Keep the two in sync.)
.decl SubagentLaunch(id: symbol, st: symbol)
SubagentLaunch(id, st) :- InContext(id), ToolResult(id, "Task", args),
    st = @json_get_str(args, "subagent_type").
SubagentLaunch(id, st) :- InContext(id), ToolResult(id, "Agent", args),
    st = @json_get_str(args, "subagent_type").
SubagentLaunch(id, st) :- InContext(id), ToolResult(id, "TaskCreate", args),
    st = @json_get_str(args, "subagent_type").
SubagentLaunch(id, st) :- InContext(id), ToolResult(id, "TaskRun", args),
    st = @json_get_str(args, "subagent_type").
ReviewArtifact(id) :- SubagentLaunch(id, st),
    @str_contains(st, "review") = 1, @str_contains(st, "preview") = 0.
ReviewArtifact(id) :- SubagentLaunch(id, st), @str_contains(st, "security") = 1.
ReviewArtifact(id) :- InContext(id), ToolResult(id, "Skill", args),
    sk = @json_get_str(args, "command"),
    @str_contains(sk, "review") = 1, @str_contains(sk, "preview") = 0.

// An edit is reviewed iff a review ran *after* it (reachable from the edit), so
// edits made after the last review stay unreviewed — large audit-suggested
// fixes need a re-review. Mirrors the secret-scan coverage logic (`Reaches`).
.decl ReviewedEdit(edit: symbol)
ReviewedEdit(e) :- RecentEdit(e), ReviewArtifact(r), Reaches(e, r).

// Size of an edit (characters written): Edit→new_string, Write→content,
// MultiEdit→whole-args length as a proxy.
.decl EditSize(edit: symbol, size: number)
EditSize(e, n) :- RecentEdit(e), ToolResult(e, "Edit", args),
    s = @json_get_str(args, "new_string"), n = @str_len(s).
EditSize(e, n) :- RecentEdit(e), ToolResult(e, "Write", args),
    s = @json_get_str(args, "content"), n = @str_len(s).
EditSize(e, n) :- RecentEdit(e), ToolResult(e, "MultiEdit", args), n = @str_len(args).

// ── Review-gate sizing: git-diff PRIMARY, transcript char-sum FALLBACK ──
// PRIMARY (in a git repo — the normal case for a push): the daemon captures a
// git ANCHOR the moment a review runs (its PostToolUse) and, on a push, reports
// the UNREVIEWED delta as added+deleted lines since that anchor — the whole
// tracked tree if no review was ever captured (see review-diff.ts). git measures
// this accurately: churn that cancels, whole-file Write rewrites, and scratchpad
// / out-of-repo edits all resolve the way you'd want, unlike summing transcript
// edit char-counts (which overcount all three and gate on every temp-file write).
.decl ReviewDiffAvailable(idx: unsigned)
ReviewDiffAvailable(idx) :- ActionMetadata(idx, "review_diff_available", _, _).
.decl UnreviewedDiffLines(idx: unsigned, n: number)
UnreviewedDiffLines(idx, n) :- ActionMetadata(idx, "unreviewed_diff_lines", _, v), n = to_number(v).

// Git-path threshold in changed lines (added+deleted) — configurable, default 150.
.decl ReviewDiffLinesConfigured()
ReviewDiffLinesConfigured() :- PolicyMetadata("review_diff_lines", _, _).
.decl ReviewDiffThreshold(n: number)
ReviewDiffThreshold(n) :- PolicyMetadata("review_diff_lines", v, _), n = to_number(v).
ReviewDiffThreshold(150) :- !ReviewDiffLinesConfigured().

// A diff measured FROM the review anchor: what changed SINCE a review, as
// opposed to the same number of lines that no review ever saw. The daemon emits
// this only when every measured push target used the anchor as its base.
.decl ReviewAnchored(idx: unsigned)
ReviewAnchored(idx) :- ActionMetadata(idx, "review_anchored", _, _).

// Threshold for that post-review case — configurable, default 500. It is
// DELIBERATELY looser than the never-reviewed bound. A fix answering review
// findings carries its regression test and its doc update in the same change
// (this project requires all three), so a one-line behaviour fix routinely runs
// to a few hundred lines; measured on the branch that added this gate's own
// rules, the median such fix was ~350 lines and only the outliers passed 500.
// Grading those on the never-reviewed bound re-gates the fix for the review that
// just happened, which trains people to push through the prompt rather than read
// it. The looser bound is not free — it rides on the same trust as the anchor
// itself, since launching a review is what sets the anchor — but it widens
// nothing that the anchor did not already grant: an anchor set at HEAD already
// makes the diff since it zero.
.decl ReviewFixLinesConfigured()
ReviewFixLinesConfigured() :- PolicyMetadata("review_fix_diff_lines", _, _).
.decl ReviewFixThreshold(n: number)
ReviewFixThreshold(n) :- PolicyMetadata("review_fix_diff_lines", v, _), n = to_number(v).
ReviewFixThreshold(500) :- !ReviewFixLinesConfigured().

// FALLBACK (transcript path, only when no git diff is available — a non-repo
// context, which can't actually push): per-edit char threshold, default 800.
.decl ReviewThresholdConfigured()
ReviewThresholdConfigured() :- PolicyMetadata("review_edit_threshold", _, _).
.decl ReviewEditThreshold(n: number)
ReviewEditThreshold(n) :- PolicyMetadata("review_edit_threshold", v, _), n = to_number(v).
ReviewEditThreshold(800) :- !ReviewThresholdConfigured().

.decl LargeUnreviewedEdit(idx: unsigned)
// Git path, never reviewed: the whole unpushed diff exceeds the strict bound.
LargeUnreviewedEdit(idx) :- ReviewDiffAvailable(idx), !ReviewAnchored(idx),
    UnreviewedDiffLines(idx, n), ReviewDiffThreshold(t), n > t.
// Git path, measured since a review: graded on the looser post-review bound.
LargeUnreviewedEdit(idx) :- ReviewDiffAvailable(idx), ReviewAnchored(idx),
    UnreviewedDiffLines(idx, n), ReviewFixThreshold(t), n > t.
// Transcript fallback: a large single edit unreviewed since it was made.
LargeUnreviewedEdit(idx) :- IsPush(idx), !ReviewDiffAvailable(idx),
    EditSize(e, n), ReviewEditThreshold(t), n > t, !ReviewedEdit(e).

// @ask
// @deny_message: Pushing substantial code edits not reviewed since they were made (large changes — incl. audit-suggested fixes — need a (re-)review)
// @suggestion: The agent must review the latest changes (a code-review subagent, or the /review skill) before this push is allowed
Unauthorized(idx) :- RuleEnabled("review_gate"), IsPush(idx), LargeUnreviewedEdit(idx).

/* ── Static analysis (opt-in; Tier-0 deny or Tier-1 @ask, by severity) ──
   Gates a push on findings from the project's OWN static analyser, read by the
   daemon out of a SARIF file and attached as ActionMetadata. The guard runs no
   scanner and bundles none: any engine that emits SARIF works (Semgrep,
   opengrep, CodeQL, Bandit, Pysa), so which one runs is the policy owner's
   decision. That also keeps engine licensing out of this product — CodeQL, for
   one, may not be used on a non-open-source codebase without paid GitHub
   Advanced Security, and may not be redistributed or hosted by us at all;
   reading a file their licensed scanner wrote raises neither question.

   This does NOT replace review_gate, and the two answer different questions. The
   review gate establishes that somebody looked at the change; it cannot
   establish that what they looked at is safe. Static analysis finds what the
   look missed. Both, or neither claim is worth much.

   ENTIRELY OFF unless configured: with no sast_action facts seeded, SastAction
   is empty and neither rule below can fire, whatever the SARIF says. */
.decl SastAction(sev: symbol, action: symbol)
SastAction(sev, action) :- PolicyMetadata("sast_action", sev, action).
.decl SastConfigured()
SastConfigured() :- SastAction(_, _).


.decl SastFindings(idx: unsigned, sev: symbol, n: number)
SastFindings(idx, sev, n) :- ActionMetadata(idx, "sast_finding", sev, v), n = to_number(v).

// Results that are missing, unreadable, or older than the code they describe.
// The daemon reports this rather than "no findings", so deleting the file is not
// a way through the gate; the policy treats it as the absence of evidence.
.decl SastStale(idx: unsigned)
SastStale(idx) :- ActionMetadata(idx, "sast_stale", _, _).

// @deny_message: Static analysis found problems at a severity the policy blocks
// @suggestion: Fix the reported findings and re-run the analyser until the blocking severities are clear, then push
Unauthorized(idx) :- RuleEnabled("sast"), IsPush(idx),
    SastFindings(idx, sev, n), n > 0, SastAction(sev, "block").

// @ask
// @deny_message: Static analysis found problems at a severity the policy asks about
// @suggestion: Review the reported findings; fix them and re-run the analyser, or approve the push when prompted
Unauthorized(idx) :- RuleEnabled("sast"), IsPush(idx),
    SastFindings(idx, sev, n), n > 0, SastAction(sev, "ask").

// @ask
// @deny_message: Static-analysis results are missing or older than the code being pushed, so nothing was checked
// @suggestion: Re-run the analyser so its results cover the latest edits, then push; or approve the push when prompted
Unauthorized(idx) :- RuleEnabled("sast"), IsPush(idx), SastConfigured(), SastStale(idx).

// The project's committed `.sasy/project.json` and `.sasy/overrides.json` are
// applied by the daemon before the facts above are built: an overridden
// finding is set aside (`sast_overridden` counts them, nothing gates on it)
// and a demoted finding arrives as `low`. When either file is present at HEAD
// but cannot be honoured, the daemon says so rather than quietly applying
// neither — a typo in the project's STRICTER table must not weaken the gate,
// and the person who wrote an override should learn that it never applied.
.decl SastProjectInvalid(idx: unsigned, why: symbol)
SastProjectInvalid(idx, why) :- ActionMetadata(idx, "sast_project_invalid", why, _).

// @ask
// @deny_message: The project's .sasy/ configuration at HEAD could not be read, so its exclusions and overrides were not applied
// @suggestion: Fix .sasy/project.json or .sasy/overrides.json (the daemon log names the problem) and commit, then push; or approve the push when prompted
Unauthorized(idx) :- RuleEnabled("sast"), IsPush(idx), SastConfigured(), SastProjectInvalid(idx, _).

/* ── 10b. Findings in files THIS session edited ────────────────────────
   The counts above cannot say WHERE a finding is, so a policy cannot treat
   "you just wrote this" differently from "it was already there". The daemon
   now emits one `sast_at(<repo-relative file>, <severity>)` per file and
   severity actually found, which SARIF has carried all along — the location
   and severity of every result were parsed and then aggregated away.

   Paths are compared by reconstructing the absolute path (`repo_root` carries
   its trailing slash) rather than by substring, so `src/a.py` cannot match an
   edit to `vendor/src/a.py`.

   OFF unless `sast_edited_action` is seeded, exactly like the rules above: a
   deployment that has not asked to be stricter about its own edits sees no
   change. */
.decl SastAt(idx: unsigned, file: symbol, sev: symbol)
SastAt(idx, file, sev) :- ActionMetadata(idx, "sast_at", file, sev).

// The detail list is bounded daemon-side. When it overflows, `sast_at` no
// longer names every file, so a rule keyed on it would silently stop firing.
.decl SastDetailCapped(idx: unsigned)
SastDetailCapped(idx) :- ActionMetadata(idx, "sast_detail_capped", _, _).

.decl SastEditedAction(sev: symbol, action: symbol)
SastEditedAction(sev, action) :- PolicyMetadata("sast_edited_action", sev, action).
.decl SastEditedConfigured()
SastEditedConfigured() :- SastEditedAction(_, _).
// Either table counts as "the owner asked for this gate". Recognising only the
// first meant a deployment that configured ONLY the edited-file table got no
// staleness check: delete the SARIF, edit a file, push, and the stale rule
// above could not fire because SastConfigured was false.
SastConfigured() :- SastEditedAction(_, _).

.decl SastFileEditedHere(file: symbol)
SastFileEditedHere(file) :-
    SastAt(_, file, _), RecentEdit(id), ToolResult(id, _, args), RepoRoot(root),
    @json_get_str(args, "file_path") = cat(root, file).

// @deny_message: Static analysis flagged a file this session edited, at a severity the policy blocks
// @suggestion: Fix the finding in the file you edited and re-run the analyser, then push
Unauthorized(idx) :- RuleEnabled("sast"), IsPush(idx),
    SastAt(idx, file, sev), SastFileEditedHere(file), SastEditedAction(sev, "block").

// @ask
// @deny_message: Static analysis flagged a file this session edited
// @suggestion: Review the finding in the file you edited; fix it and re-run the analyser, or approve the push when prompted
Unauthorized(idx) :- RuleEnabled("sast"), IsPush(idx),
    SastAt(idx, file, sev), SastFileEditedHere(file), SastEditedAction(sev, "ask").

// @ask
// @deny_message: Static-analysis detail was truncated, so findings in files edited this session cannot be identified
// @suggestion: Narrow the analyser scope (or set sastScope to "changed") so the results fit, then push; or approve the push when prompted
Unauthorized(idx) :- RuleEnabled("sast"), IsPush(idx),
    SastEditedConfigured(), SastDetailCapped(idx).

/* ── 11. Supply-chain cooldown (Tier-0 deny + Tier-1 @ask) ──────────────
   Gates dependency installs on daemon-resolved per-action metadata: the daemon
   intercepts an npm/pnpm/yarn/pip/uv install, enumerates the transitive closure,
   queries the registry packument + OSV, and attaches verdicts via
   ActionMetadata(idx, "pkg_verdict"|"pkg_age"|"security_update", pkg, v). The
   Soufflé side stays pure — it reads verdicts and decides (see docs
   "Metadata binding" for why the daemon, not a functor). Config: cooldown window
   via PolicyMetadata("cooldown_days", "<n>", "") (default 7). */
.decl CooldownConfigured()
CooldownConfigured() :- PolicyMetadata("cooldown_days", _, _).
.decl CooldownDays(n: number)
CooldownDays(n) :- PolicyMetadata("cooldown_days", v, _), n = to_number(v).
CooldownDays(7) :- !CooldownConfigured().

.decl PackageVerdict(idx: unsigned, pkg: symbol, advisory: symbol)
PackageVerdict(idx, pkg, v) :- ActionMetadata(idx, "pkg_verdict", pkg, v).
.decl PackageAgeDays(idx: unsigned, pkg: symbol, days: number)
PackageAgeDays(idx, pkg, d) :- ActionMetadata(idx, "pkg_age", pkg, v), d = to_number(v).
.decl SecurityUpdate(idx: unsigned, pkg: symbol)
SecurityUpdate(idx, pkg) :- ActionMetadata(idx, "security_update", pkg, _).

/* ── Enrichment unavailable → @ask (honor fail-closed on a missing signal) ──
   The daemon resolves supply-chain (OSV/registry) and repo-visibility facts out
   of band. If that resolution FAILS or times out for a sink action (an install,
   or a push/post to a remote), the hard/soft rules above never see their fact
   and would silently allow — a fail-open exploitable by inducing a timeout. In
   fail-closed mode the daemon instead attaches enrich_unavailable(<group>) so
   the action @asks rather than slipping through unverified. Gated on the group
   so a disabled group stays silent. */
.decl EnrichUnavailable(idx: unsigned, grp: symbol)
EnrichUnavailable(idx, grp) :- ActionMetadata(idx, "enrich_unavailable", grp, _).

DenialReason(idx, "ask",
  "Could not verify external context for this action — package advisories or repository visibility were unreachable, so a security check was skipped",
  "Retry when the network/registry is reachable, or approve when prompted to proceed without the check.") :-
    Actions(idx, _), EnrichUnavailable(idx, grp), RuleEnabled(grp).

// @deny_message: A dependency in this install is flagged malicious by OSV (MAL-) — blocked
// @suggestion: Remove the flagged package; if you expected a different name, check for a typosquat
Unauthorized(idx) :- RuleEnabled("supply_chain"), PackageVerdict(idx, _, v), @str_contains(v, "MAL-") = 1.

.decl TooNew(idx: unsigned, pkg: symbol)
TooNew(idx, pkg) :-
    PackageAgeDays(idx, pkg, d), CooldownDays(n), d < n, !SecurityUpdate(idx, pkg).
// @ask
// @deny_message: A dependency is newer than the cooldown window — malicious releases are typically caught and unpublished within days
// @suggestion: Pin an older vetted version or wait out the cooldown window; approve when prompted only if this release is trusted
Unauthorized(idx) :- RuleEnabled("supply_chain"), TooNew(idx, _).

/* ── 12. OSV scan gate on dependency changes before push (Tier-1, @ask) ──
   Complements the install-time supply_chain verdicts (which only see a tracked
   install command's closure + MAL/age): if a dependency manifest/lockfile
   changed in the slice and no clean `osv-scanner` run covers it, confirm before
   push. Catches manifest edits made WITHOUT an install command, and known
   CVEs/transitive vulns. Mirrors the gitleaks secret-scan gate (graph coverage
   via Reaches), but @ask — osv-scanner may be absent and some transitive vulns
   are unfixable, so don't hard-block. Runs over the agent's own osv-scanner
   invocations (Bash), not an MCP tool. */

.decl DepManifestFrag(frag: symbol)
DepManifestFrag("package.json").     DepManifestFrag("package-lock.json").
DepManifestFrag("yarn.lock").        DepManifestFrag("pnpm-lock.yaml").
DepManifestFrag("requirements.txt"). DepManifestFrag("pyproject.toml").
DepManifestFrag("poetry.lock").      DepManifestFrag("Pipfile").
DepManifestFrag("Cargo.toml").       DepManifestFrag("Cargo.lock").
DepManifestFrag("go.mod").           DepManifestFrag("go.sum").
DepManifestFrag("Gemfile").          DepManifestFrag("Gemfile.lock").

// An edit (in the slice) to a dependency manifest/lockfile.
.decl DependencyEdit(id: symbol, path: symbol)
DependencyEdit(e, p) :- RecentEdit(e), ToolResult(e, "Edit", args),
    DepManifestFrag(f), p = @json_get_str(args, "__sasy_edit_path"), p != "",
    @str_contains(p, f) = 1.
DependencyEdit(e, p) :- RecentEdit(e), ToolResult(e, "Write", args),
    DepManifestFrag(f), p = @json_get_str(args, "__sasy_edit_path"), p != "",
    @str_contains(p, f) = 1.
DependencyEdit(e, p) :- RecentEdit(e), ToolResult(e, "MultiEdit", args),
    DepManifestFrag(f), p = @json_get_str(args, "__sasy_edit_path"), p != "",
    @str_contains(p, f) = 1.
// If an older host did not provide cwd, retain the edit as uncovered. It can
// still trigger the gate but can never be covered by an unscoped scan.
DependencyEdit(e, p) :- RecentEdit(e), ToolResult(e, "Edit", args),
    @json_get_str(args, "__sasy_edit_path") = "", DepManifestFrag(f),
    p = @json_get_str(args, "file_path"), @str_contains(p, f) = 1.
DependencyEdit(e, p) :- RecentEdit(e), ToolResult(e, "Write", args),
    @json_get_str(args, "__sasy_edit_path") = "", DepManifestFrag(f),
    p = @json_get_str(args, "file_path"), @str_contains(p, f) = 1.
DependencyEdit(e, p) :- RecentEdit(e), ToolResult(e, "MultiEdit", args),
    @json_get_str(args, "__sasy_edit_path") = "", DepManifestFrag(f),
    p = @json_get_str(args, "file_path"), @str_contains(p, f) = 1.

// The transcript mapper, not Datalog string matching, validates OSV evidence:
// a sole canonical command, target `.`, structured non-error outcome, clean
// summary line, and the session cwd are required before these reserved fields
// are attached. User-supplied fields with these names are stripped.
.decl OsvClean(id: symbol, scope: symbol)
OsvClean(id, scope) :-
    InContext(id), ToolResult(id, "Bash", args),
    @json_get_str(args, "__sasy_osv_clean") = "1",
    scope = @json_get_str(args, "__sasy_osv_scope"), scope != "".

// A dependency edit is covered iff a clean project-root scan ran after it and
// the edited manifest is actually inside the scanned scope.
.decl OsvCoveredEdit(edit: symbol)
OsvCoveredEdit(e) :- DependencyEdit(e, p), OsvClean(s, root),
    @str_starts_with(p, root) = 1, Reaches(e, s).
.decl UncoveredDependencyEdit()
UncoveredDependencyEdit() :- DependencyEdit(e, _), !OsvCoveredEdit(e).

// @ask
// @deny_message: Dependency files changed without a clean osv-scanner run — possible vulnerable/known-bad dependencies
// @suggestion: Run `osv-scanner scan source --recursive .` from the project root until clean, then push; or approve the push when prompted
Unauthorized(idx) :- RuleEnabled("dep_scan"), IsPush(idx), UncoveredDependencyEdit().

/* ── Reaches definition (sink-rooted; see the .decl near the top) ──────────
   Every consumer queries Reaches(<edit|scan>, <sink>) where the sink is a
   scan/review node (GitleaksRun/GitleaksClean/ReviewArtifact/OsvClean) — a handful
   per session. Computing reachability BACKWARD from those sinks (rather than the old
   all-pairs closure from every node) yields the identical (src,dst) pairs the
   consumers need at O(|sinks|·n) ≈ O(n) instead of O(n²). Placed here so every sink
   relation above is already declared. */
.decl ReachSink(n: symbol)
ReachSink(s) :- GitleaksRun(s).
ReachSink(s) :- GitleaksClean(s).
ReachSink(r) :- ReviewArtifact(r).
ReachSink(s) :- OsvClean(s, _).

// Relevance gate (mirrors common_policy's *PolicyRelevant pattern): Reaches is
// consumed ONLY by secret_scan / review_gate / dep_scan, all of which fire only on
// IsPush. So for every NON-push action — the vast majority of checks — skip the
// closure entirely. Add to this predicate if a non-push rule ever consumes Reaches.
.decl ReachesRelevant()
ReachesRelevant() :- IsPush(_).
Reaches(src, dst) :- ReachesRelevant(), ReachSink(dst), Edge(src, dst).
Reaches(src, dst) :- Edge(src, mid), Reaches(mid, dst).

/* ── Gate CurrentDepends (O(n) backward dependency traversal) on relevance ──────
   CurrentDepends — and InContext / RecentEdit built on it — is consumed ONLY by:
     · the hidden-unicode taint gate      → needs a HiddenUnicodeSource
     · exfil (UntrustedInContext)         → needs an untrusted WebFetch/WebSearch/
                                            RemoteAgent result
     · toxic_flow (SensitiveInContext)    → needs a sensitive read in the session
     · the push gates secret_scan/review/dep_scan (RecentEdit / GitleaksRun /
       ReviewArtifact / OSV)              → needs IsPush
   So a benign non-push action with none of those present — the common case — can
   skip the whole backward traversal. Each condition is a CHEAP existence check over
   base facts (no CurrentDepends → no circularity), and each is a SUPERSET of the
   InContext-joined need, so the gate never drops a real detection (fail-safe).
   Defining rules for CurrentDependsPolicyRelevant here suppresses sugar.py's
   trivially-true default (it scopes the check to user-policy lines). */
.decl UntrustedResultExists()
UntrustedResultExists() :- ToolResult(_, "WebFetch", _).
UntrustedResultExists() :- ToolResult(_, "WebSearch", _).
UntrustedResultExists() :- ToolResult(_, "RemoteAgent", _).
.decl SensitiveReadExists()
SensitiveReadExists() :- ToolResult(_, "Read", args),
    p = @json_get_str(args, "file_path"), SensitivePath(s), @str_contains(p, s) = 1.
SensitiveReadExists() :- ToolResult(_, "Bash", args),
    cmd = @json_get_str(args, "command"), n = @normalize_cmd(cmd),
    SensitiveReadVerb(v), @str_contains(n, v) = 1, SensitivePath(s), @str_contains(n, s) = 1.
CurrentDependsPolicyRelevant() :- HiddenUnicodeSource(_).
CurrentDependsPolicyRelevant() :- UntrustedResultExists().
CurrentDependsPolicyRelevant() :- SensitiveReadExists().
CurrentDependsPolicyRelevant() :- IsPush(_).
